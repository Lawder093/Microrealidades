# Usar exclusivamente un proyecto Supabase de PRUEBAS, en el ambiente Preview de Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO_DE_PRUEBAS.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_LLAVE_PUBLICA_DE_PRUEBAS
# Solo servidor. Nunca agregar NEXT_PUBLIC_ a esta variable.
SUPABASE_SECRET_KEY=TU_LLAVE_SECRETA_DE_PRUEBAS
# Si se usan los nombres legacy, ANON_KEY y SERVICE_ROLE_KEY son alternativas, no llaves adicionales.
